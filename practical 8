#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *prev;
    struct Node *next;
};

struct Node *head = NULL;

void insert(int x, int pos)
{
    struct Node *newNode, *temp;
    int i;

    if (pos < 1)
    {
        printf("Invalid position\n");
        return;
    }

    newNode = malloc(sizeof(struct Node));

    if (newNode == NULL)
        return;

    newNode->data = x;
    newNode->prev = NULL;
    newNode->next = NULL;

    if (pos == 1)
    {
        newNode->next = head;

        if (head != NULL)
            head->prev = newNode;

        head = newNode;
        return;
    }

    temp = head;

    for (i = 1; temp != NULL && i < pos - 1; i++)
        temp = temp->next;

    if (temp == NULL)
    {
        printf("Invalid position\n");
        free(newNode);
        return;
    }

    newNode->next = temp->next;
    newNode->prev = temp;

    if (temp->next != NULL)
        temp->next->prev = newNode;

    temp->next = newNode;
}

void deletePosition(int pos)
{
    struct Node *temp;
    int i;

    if (pos < 1 || head == NULL)
    {
        printf("Invalid position or empty list\n");
        return;
    }

    temp = head;

    for (i = 1; temp != NULL && i < pos; i++)
        temp = temp->next;

    if (temp == NULL)
    {
        printf("Invalid position\n");
        return;
    }

    if (temp->prev != NULL)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if (temp->next != NULL)
        temp->next->prev = temp->prev;

    printf("Deleted: %d\n", temp->data);
    free(temp);
}

void display()
{
    struct Node *temp = head;

    while (temp != NULL)
    {
        printf("%d <-> ", temp->data);
        temp = temp->next;
    }

    printf("NULL\n");
}

int main()
{
    insert(10, 1);
    insert(30, 2);
    insert(20, 2);

    printf("Doubly Linked List: ");
    display();

    deletePosition(2);

    printf("After deletion: ");
    display();

    return 0;
}

output 
Doubly Linked List: 10 <-> 20 <-> 30 <-> NULL
Deleted: 20
After deletion: 10 <-> 30 <-> NULL